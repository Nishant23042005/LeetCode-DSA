// LeetCode 1382
// Balance a Binary Search Tree
// Topic: Binary Search Tree, Inorder Traversal, Divide and Conquer
// Difficulty: Medium
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
    public TreeNode solve(int l, int r, ArrayList<Integer> arr) {
        if (l > r) {
            return null;
        }

        int mid = l + (r - l) / 2;
        TreeNode node = new TreeNode(arr.get(mid));

        node.left = solve(l, mid - 1, arr);
        node.right = solve(mid + 1, r, arr);

        return node;
    }

    public void inorder(TreeNode root, ArrayList<Integer> arr) {
        if (root == null) {
            return;
        }

        inorder(root.left, arr);
        arr.add(root.val);
        inorder(root.right, arr);
    }

    public TreeNode balanceBST(TreeNode root) {
        ArrayList<Integer> arr = new ArrayList<>();

        inorder(root, arr);

        return solve(0, arr.size() - 1, arr);
    }
}
