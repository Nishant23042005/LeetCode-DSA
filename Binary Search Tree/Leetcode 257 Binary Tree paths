// LeetCode 257
// Binary Tree Paths
// Topic: Binary Tree, DFS, Backtracking
// Difficulty: Easy
// Time Complexity: O(n)
// Space Complexity: O(h)

class Solution {
    public void path(TreeNode root, StringBuilder sb, List<String> ans) {
        int len = sb.length();

        sb.append(root.val);

        if (root.left == null && root.right == null) {
            ans.add(sb.toString());
        } else {
            sb.append("->");

            if (root.left != null) {
                path(root.left, sb, ans);
            }

            if (root.right != null) {
                path(root.right, sb, ans);
            }
        }

        sb.setLength(len);
    }

    public List<String> binaryTreePaths(TreeNode root) {
        List<String> ans = new ArrayList<>();
        path(root, new StringBuilder(), ans);
        return ans;
    }
}
