// LeetCode 19
// Remove Nth Node From End of List
// Topic: Linked List, Two Pointers
// Difficulty: Medium
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        int len = 0;
        ListNode curr = head;

        while (curr != null) {
            len++;
            curr = curr.next;
        }

        if (len == n) {
            return head.next;
        }

        curr = head;
        int pos = len - n;

        for (int i = 1; i < pos; i++) {
            curr = curr.next;
        }

        curr.next = curr.next.next;
        return head;
    }
}
