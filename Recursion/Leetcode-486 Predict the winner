// LeetCode 486
// Predict the Winner
// Topic: Dynamic Programming, Recursion
// Difficulty: Medium
// Time Complexity: O(2^n)
// Space Complexity: O(n)

class Solution {
    public boolean predictTheWinner(int[] nums) {
        int sum = 0;
        int n = nums.length;

        for (int i = 0; i < n; i++) {
            sum += nums[i];
        }

        int player1 = solve(0, n - 1, nums);
        int player2 = sum - player1;

        return player1 >= player2;
    }

    public int solve(int i, int j, int[] nums) {
        if (i > j) {
            return 0;
        }

        if (i == j) {
            return nums[i];
        }

        int take1 = nums[i] + Math.min(
            solve(i + 2, j, nums),
            solve(i + 1, j - 1, nums)
        );

        int take2 = nums[j] + Math.min(
            solve(i + 1, j - 1, nums),
            solve(i, j - 2, nums)
        );

        return Math.max(take1, take2);
    }
}
