// LeetCode 2187
// Minimum Time to Complete Trips
// Topic: Arrays, Binary Search
// Difficulty: Medium
// Time Complexity: O(n log(totalTrips × minTime))
// Space Complexity: O(1)

class Solution {
    public boolean canComplete(int[] time, long mid, int totalTrips) {
        long trips = 0;

        for (int t : time) {
            trips += mid / t;

            if (trips >= totalTrips) {
                return true;
            }
        }

        return false;
    }

    public long minimumTime(int[] time, int totalTrips) {
        long low = 1;

        int min = Integer.MAX_VALUE;

        for (int t : time) {
            min = Math.min(min, t);
        }

        long high = (long) totalTrips * min;
        long ans = high;

        while (low <= high) {
            long mid = low + (high - low) / 2;

            if (canComplete(time, mid, totalTrips)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return ans;
    }
}
